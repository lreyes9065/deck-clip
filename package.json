{
  "name": "decky-clipport",
  "version": "0.15.1",
  "description": "Your Steam clips, ready to go. Export full-length clips and scan a QR code to download them to your phone over local Wi-Fi.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:decky": "sh scripts/package-decky.sh",
    "release": "pnpm run typecheck && pnpm run test:frontend && pnpm run check:decky && pnpm run test:backend && pnpm run build && pnpm run package:decky",
    "test:frontend": "node --test tests/navigation.test.mjs tests/thumbnail-retry.test.mjs tests/backend-call.test.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python3 -m unittest discover -s tests -v",
    "check:decky": "python3 scripts/lint-plugin-json.py && python3 scripts/check-decky-imports.py"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-router": "5.3.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
