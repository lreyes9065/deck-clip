{
  "name": "deckclip",
  "version": "0.1.1",
  "description": "Export Steam Game Recording clips from Decky Loader",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package:decky": "sh scripts/package-decky.sh",
    "release": "pnpm run typecheck && pnpm run test:backend && pnpm run build && pnpm run package:decky",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python3 -m unittest discover -s tests -v"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-router": "5.3.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
